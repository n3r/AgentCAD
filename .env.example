# AgentCAD hosted configuration. Copy to `.env` — which is NOT committed.
#
# TRUST: an account on this instance can execute arbitrary Python on the host;
# give one only to someone you would give a shell to.

# REQUIRED. The origin people type, scheme included, no trailing slash and no
# path. Every Host and Origin check compares against it and every enrolment
# URL is built from it, so a wrong value shows up immediately as 403s.
AGENTCAD_PUBLIC_ORIGIN=https://cad.example.com

# Optional. At least 32 characters. Leave it empty and one is generated and
# persisted 0600 in the state directory on first boot — which is correct for a
# single instance; set it explicitly if you ever restore state onto a new host
# and want the same key.
#   Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AGENTCAD_SECRET_KEY=

# Only read by the `proxy` profile (Caddy + automatic ACME). Must resolve
# publicly to this host, or ACME will not issue.
AGENTCAD_DOMAIN=cad.example.com
